# FinShield AI — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs

# API Keys
MISTRAL_API_KEY=your_mistral_api_key_here

# Database
POSTGRES_USER=finshield
POSTGRES_PASSWORD=finshield_password
POSTGRES_DB=finshield_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://finshield:finshield_password@localhost:5432/finshield_db

# Auth JWT
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# App
DEBUG=True
ENVIRONMENT=development
